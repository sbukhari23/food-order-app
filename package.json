    "@stripe/stripe-js": "^9.15.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "lucide-react": "^1.43.0",
    "mongoose": "^9.9.5",
    "next": "^16.3.4",
    "next-auth": "^4.24.15",
    "react": "^19.2.8",
