    "@types/react-dom": "^19.2.7",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
